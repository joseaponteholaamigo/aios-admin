# Copia este archivo a `.env` para `npm run dev`. `.env` no se sube al repo.

# Los orígenes desde los que el navegador llega al panel, separados por coma.
# En desarrollo, el de Vite; en AWS, https://<id>.cloudfront.net (y en M4, https://admin.beenso.com).
PUBLIC_ORIGINS=http://localhost:5173

# Dónde viven las sesiones. «memory» solo para npm run dev; en AWS, «dynamodb» con
# SESSION_TABLE y SESSION_KMS_KEY_ID.
SESSION_STORE=memory

# El proveedor de identidad. En desarrollo, la identidad falsa que corre en el mismo servidor de
# Vite (/dev/identity). En AWS, el pool del equipo: COGNITO_POOL_ID en vez de COGNITO_CLIENT_SECRET,
# porque ahí el secreto se lee del pool.
COGNITO_LOGIN_URL=http://localhost:5173/dev/identity
COGNITO_ISSUER=http://localhost:5173/dev/identity
COGNITO_CLIENT_ID=panel-local
COGNITO_CLIENT_SECRET=secreto-local
