# Copia este archivo a `.env` para `npm run dev`. `.env` no se sube al repo.

# Los orígenes desde los que el navegador llega al panel, separados por coma.
# En desarrollo, el de Vite; en AWS, https://<id>.cloudfront.net (y en M4, https://admin.beenso.com).
PUBLIC_ORIGINS=http://localhost:5173

# Dónde viven las sesiones. «memory» solo para npm run dev; en AWS, «dynamodb» con
# SESSION_TABLE y SESSION_KMS_KEY_ID.
SESSION_STORE=memory
